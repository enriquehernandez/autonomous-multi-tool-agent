# ==========================================
# CONFIGURACIÓN DEL PROVEEDOR DE IA (LLM)
# ==========================================
# Opciones válidas: OPENROUTER, OPENAI, GOOGLE, GROQ
# Recomendado: OPENROUTER (Soporta Visión + Tool Calling con una sola API Key)
LLM_PROVIDER=OPENROUTER

# Modelo por defecto para OpenRouter (Multimodal: acepta imágenes y texto)
# Otros modelos buenos: openai/gpt-4o, google/gemini-2.5-flash, anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=google/gemini-2.5-flash

# Si usas otro proveedor, configura su modelo aquí (opcional)
OPENAI_MODEL=gpt-4o
GOOGLE_MODEL=gemini-1.5-pro
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# API KEYS (SECRETOS)
# ==========================================
# Obtén tu API Key gratis en: https://openrouter.ai/keys
# OpenRouter te permite probar múltiples modelos (incluyendo los gratuitos) con una sola key.
OPENROUTER_API_KEY=sk-or-v1-tu_api_key_aqui

# Si decides cambiar de proveedor, descomenta y rellena la que corresponda:
# OPENAI_API_KEY=sk-proj-tu_api_key_aqui
# GOOGLE_API_KEY=tu_api_key_de_google_ai_studio
# GROQ_API_KEY=gsk_tu_api_key_de_groq

# ==========================================
# API KEYS PARA LAS HERRAMIENTAS (TOOLS)
# ==========================================
# IMPORTANTE: Para este proyecto de portafolio, NO necesitas pagar ni registrarte.
# Usaremos APIs públicas y gratuitas. Deja estas variables vacías o usa los valores por defecto.
# El código de las tools (currency_tool.py y weather_tool.py) hará las peticiones a endpoints abiertos.

# 1. EXCHANGE_RATE_API_KEY (Para convertir divisas)
# - Opción A (Recomendada): Deja esto VACÍO. Usaremos la API gratuita de Frankfurter (https://frankfurter.dev/) 
#   que no requiere autenticación y da tipos de cambio oficiales de bancos centrales.
# - Opción B: Si quieres usar un servicio comercial (ej. ExchangeRate-API), pon tu key aquí.
EXCHANGE_RATE_API_KEY=

# 2. WEATHER_API_KEY (Para consultar el clima)
# - Opción A (Recomendada): Deja esto VACÍO. Usaremos Open-Meteo (https://open-meteo.com/),
#   una API gratuita, sin registro y con hasta 10,000 peticiones diarias.
# - Opción B: Si decides usar OpenWeatherMap u otro, pon tu key aquí.
WEATHER_API_KEY=

# ==========================================
# CONFIGURACIÓN ADICIONAL (Opcional)
# ==========================================
# Nivel de detalle de los logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO